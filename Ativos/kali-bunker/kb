#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

if [[ $EUID -eq 0 && -n ${SUDO_USER:-} ]]; then
  operational_home="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
  if [[ -n "$operational_home" ]]; then
    export KALI_BUNKER_USER="$SUDO_USER"
    export KALI_BUNKER_HOME="$operational_home"
  fi
fi

PYTHON_BIN="${KALI_BUNKER_PYTHON:-python3}"
if [[ -x "$PROJECT_DIR/.venv/bin/python" ]]; then
  PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
fi

exec "$PYTHON_BIN" "$PROJECT_DIR/bunkerctl.py" "$@"
