# Identidade usada pela fila persistente no servidor.
PC_AGENT_ID=kali-principal

# Servidor que mantém Telegram, Gmail, IA e a fila de tarefas.
PC_BRIDGE_SSH_HOST=voide@100.87.201.41
PC_BRIDGE_REMOTE_SCRIPT=/home/voide/Projetos/gmail-telegram-bot/pc_bridge.py
PC_BRIDGE_SSH_IDENTITY=/home/voide/.ssh/kali_bunker_agent

# O agente mantém um long-poll SSH aberto e consulta a fila local do servidor
# a cada 1s. Isso reduz latência sem criar um novo SSH por segundo.
PC_AGENT_POLL_SECONDS=1
PC_AGENT_LONG_POLL_SECONDS=30
PC_AGENT_METADATA_REFRESH_SECONDS=30
PC_AGENT_COMMAND_TIMEOUT=300
PC_AGENT_MAX_OUTPUT_CHARS=12000
PC_AGENT_MAX_FILE_MB=45
WEBCAM_RESOLUTION=1280x720
# WEBCAM_DEVICE=/dev/video0
