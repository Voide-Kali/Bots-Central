[Unit]
Description=Kali Bunker - Alarme Bluetooth
Wants=bluetooth.service network-online.target
After=bluetooth.service network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/voide/Kali-Bunker-main
ExecStart=/usr/bin/python3 -u /home/voide/Kali-Bunker-main/bluetooth_alarm.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
