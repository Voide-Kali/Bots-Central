[Unit]
Description=Kali Bunker - Controle de rede via Telegram
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/voide/Kali-Bunker-main
Environment=KALI_BUNKER_USER=voide
Environment=KALI_BUNKER_HOME=/home/voide
EnvironmentFile=-/home/voide/Kali-Bunker-main/.env
EnvironmentFile=-/home/voide/.config/kali-bunker/.env
ExecStart=/usr/bin/python3 -u /home/voide/Kali-Bunker-main/telegram_control.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
