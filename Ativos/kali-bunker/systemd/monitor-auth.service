[Unit]
Description=Kali Bunker - Monitor de Autenticacao
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/voide/Kali-Bunker-main
ExecStart=/usr/bin/python3 -u /home/voide/Kali-Bunker-main/monitor-auth.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=false

[Install]
WantedBy=default.target
