[Unit]
Description=Kali Bunker - Watch de Mudanca de Rede
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/voide/Kali-Bunker-main
ExecStart=/bin/bash /home/voide/Kali-Bunker-main/network-watch.sh
RuntimeDirectory=kali-bunker
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
Nice=10

[Install]
WantedBy=default.target
