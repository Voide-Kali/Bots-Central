[Unit]
Description=Notificacao de shutdown (Kali Bunker)
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/home/voide/.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/voide
ExecStart=/usr/bin/true
ExecStop=/usr/bin/python3 /home/voide/notifica_shutdown.py
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
