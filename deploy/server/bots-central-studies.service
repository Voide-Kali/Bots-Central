[Unit]
Description=Bots Central - Estudos Telegram
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bots-central
Group=bots-central
WorkingDirectory=/opt/bots-central/current/Ativos/estudos
EnvironmentFile=/etc/bots-central/studies.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/bots-central/venvs/studies/bin/python /opt/bots-central/current/Ativos/estudos/main.py
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bots-central
ReadWritePaths=/etc/bots-central

[Install]
WantedBy=multi-user.target
