# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# IA
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_EMAIL_SUMMARY_ENABLED=0

# Caminhos no servidor
KALI_BUNKER_DIR=/opt/bots-central/current/Ativos/kali-bunker
PC_BRIDGE_DB=/var/lib/bots-central/pc_bridge.db
PC_BRIDGE_ARTIFACT_DIR=/var/lib/bots-central/pc-artifacts
PC_AGENT_ID=kali-principal

# Gmail
CHECK_INTERVAL_SECONDS=60

# Recursos locais do servidor que nao devem fingir ser o notebook
BATTERY_ALERTS_ENABLED=0
SMART_ALERTS_ENABLED=1
DAILY_REPORT_ENABLED=0
