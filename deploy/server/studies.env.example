# Use um token próprio para o bot de Estudos. Não reutilize o token do bot central
# enquanto ambos executarem long polling em processos separados.
TELEGRAM_TOKEN=
ALLOWED_CHAT_IDS=

# IA
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

MAX_PDF_MB=20
MAX_DOCUMENT_CHARS=60000
MAX_HISTORY_MESSAGES=20
